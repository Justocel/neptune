# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored; `.env.example` is committed.

# --- Postgres (used by docker-compose.yml and src/neptune/config.py) ---
POSTGRES_DB=neptune
POSTGRES_USER=neptune
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- External APIs (fill as we hit each source) ---
# BLS (Bureau of Labor Statistics) — free key, http://data.bls.gov/registrationEngine/
BLS_API_KEY=

# US Census ACS — free key, https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# MBTA-Performance V3 — free key, https://api-v3.mbta.com/
MBTA_API_KEY=

# Reddit (PRAW) — free OAuth app, https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=neptune-research-bot/0.1 by u/your-reddit-username

# Google Maps Place (for populartimes) — billable, https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=

# Instagram (optional, only if instaloader needs login to dodge rate limits)
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
